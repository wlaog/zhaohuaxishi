<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="朝花夕拾 · 控制台" Width="960" Height="810" MinWidth="850" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F5F5F0" FontFamily="Microsoft YaHei UI" Foreground="#253B30">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#315D48"/><Setter Property="Background" Value="#EEF3EC"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#365B46"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="23"/><Setter Property="BorderBrush" Value="#E8EBE3"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="11,9"/><Setter Property="Background" Value="#F7F8F4"/><Setter Property="BorderBrush" Value="#DDE4DA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#253B30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Address" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0,8"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="30,23,30,19">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="BrandIcon" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel Grid.Column="1"><TextBlock Text="朝花夕拾" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="一方安静的地方，收藏每一天。" FontSize="12" Foreground="#7C897E" Margin="0,5,0,0"/></StackPanel>
   <Border Grid.Column="2" CornerRadius="12" Background="#E7EDE3" Padding="13,8" VerticalAlignment="Center"><TextBlock x:Name="ServiceStatus" Text="正在检测" FontSize="12" Foreground="#52734D"/></Border>
  </Grid>
  <StackPanel Grid.Row="1">
   <Border x:Name="Notice" Visibility="Collapsed" Background="#FFF4E2" BorderBrush="#EDDEC2" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,14"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#80613B" FontSize="12"/></Border>
   <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="3" IsIndeterminate="True" Foreground="#789469" Background="#E7EDE3" BorderThickness="0" Margin="0,0,0,14"/>
  </StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.36*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="01  /  准备环境" Foreground="#87967F" FontSize="11"/><Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="第一次使用" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeStatus" Grid.Column="1" Text="检测中" Foreground="#7D8E77" FontSize="11" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="自动准备运行环境和依赖，不用输入命令。" Foreground="#7D897F" FontSize="12" Margin="0,0,0,15"/>
      <Button x:Name="InstallButton" Content="初次使用 · 一键安装" HorizontalAlignment="Stretch"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="02  /  日常记录" Foreground="#87967F" FontSize="11"/><TextBlock Text="在电脑上打开" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,2"/>
      <TextBox x:Name="LocalAddress" Style="{StaticResource Address}" Text="http://127.0.0.1:8766"/>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Style="{StaticResource Primary}" Content="启动并打开日记"/><Button x:Name="StopButton" Grid.Column="2" Content="停止服务"/></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="03  /  另一台设备" Foreground="#87967F" FontSize="11"/><TextBlock Text="Tailscale · 私人网络" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,7"/>
      <TextBlock x:Name="PhoneStatus" Text="正在检测 Tailscale" Foreground="#7D897F" FontSize="12" TextWrapping="Wrap"/>
      <TextBox x:Name="PhoneAddress" Style="{StaticResource Address}" Text="连接 Tailscale 后自动生成地址" TextWrapping="Wrap"/>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="EnablePhoneButton" Content="开启手机访问"/><Button x:Name="DisablePhoneButton" Content="关闭手机访问" Grid.Column="2"/></Grid>
      <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="CopyPhoneButton" Content="复制地址" Background="Transparent" Padding="2,7" FontSize="11"/><Button x:Name="OpenPhoneButton" Content="浏览器打开" Background="Transparent" Padding="12,7" FontSize="11"/><Button x:Name="TailscaleHelpButton" Content="连接指引" Background="Transparent" Padding="2,7" FontSize="11"/></StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="04  /  浏览器直接访问" Foreground="#87967F" FontSize="11"/><TextBlock Text="Sakura Frp · 密码登录" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,7"/>
      <TextBlock x:Name="SakuraStatus" Text="尚未配置。先查看配置指引，完成账号和隧道设置。" Foreground="#7D897F" FontSize="12" TextWrapping="Wrap"/>
      <TextBlock Text="手机 HTTPS 地址（包含隧道的远程端口）" FontSize="12" Margin="0,16,0,7"/><TextBox x:Name="SakuraOrigin" AutomationProperties.Name="Sakura 手机 HTTPS 地址"/>
      <TextBlock Text="例如 https://你的子域名.nyat.app:远程端口" FontSize="11" Foreground="#929A90" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <TextBlock Text="独立入口的本地端口" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="SakuraPort" Text="8767" MaxLength="5" AutomationProperties.Name="Sakura 独立入口本地端口"/>
      <TextBlock Text="Sakura 隧道填本地 IP 127.0.0.1 和此端口；请勿指向上方日记端口。" FontSize="11" Foreground="#929A90" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <TextBlock Text="日记访问密码（至少 12 个字符）" FontSize="12" Margin="0,0,0,7"/><PasswordBox x:Name="SakuraPassword" Padding="11,9" FontSize="14" Background="#F7F8F4" BorderBrush="#DDE4DA" MaxLength="256" AutomationProperties.Name="Sakura 日记访问密码"/>
      <TextBlock Text="首次必须设置；以后留空保留原密码。这不是 Sakura 账号密码或访问密钥。" FontSize="11" Foreground="#929A90" TextWrapping="Wrap" Margin="0,5,0,13"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="EnableSakuraButton" Content="保存并开启入口"/><Button x:Name="DisableSakuraButton" Content="关闭入口" Grid.Column="2"/></Grid>
      <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="CopySakuraButton" Content="复制地址" Background="Transparent" Padding="2,7" FontSize="11"/><Button x:Name="OpenSakuraButton" Content="浏览器打开" Background="Transparent" Padding="12,7" FontSize="11"/><Button x:Name="SakuraHelpButton" Content="配置指引" Background="Transparent" Padding="2,7" FontSize="11"/></StackPanel>
      <Button x:Name="SakuraWebsiteButton" Content="打开 Sakura 官网 · 注册 / 安装启动器" Background="Transparent" FontSize="11" Padding="0,8" HorizontalAlignment="Left"/>
      <TextBlock Text="应用设置会重启日记服务，请先保存草稿。隧道由 Sakura 官方启动器管理；关闭入口会立即阻止通过此入口访问日记。" FontSize="11" Foreground="#929A90" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="访问设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="让地址适合你的使用习惯。" Foreground="#7D897F" FontSize="12" Margin="0,7,0,21"/>
      <TextBlock Text="本地端口" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="LocalPort" Text="8766" MaxLength="5" AutomationProperties.Name="本地端口"/>
      <TextBlock Text="仅供这台电脑访问，地址为 127.0.0.1。" TextWrapping="Wrap" Foreground="#929A90" FontSize="11" Margin="0,7,0,17"/>
      <TextBlock Text="手机 HTTPS 端口" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="HttpsPort" Text="443" MaxLength="5" AutomationProperties.Name="手机 HTTPS 端口"/>
      <TextBlock Text="通常保留 443。手机域名由 Tailscale 自动提供，无法在这里任意改名。" TextWrapping="Wrap" Foreground="#929A90" FontSize="11" Margin="0,7,0,21"/>
      <Button x:Name="ApplyButton" Content="保存并应用"/>
      <TextBlock Text="修改运行中的地址会重启服务，请先保存正在编辑的内容。" TextWrapping="Wrap" Foreground="#929A90" FontSize="11" Margin="0,10,0,0"/>
      <Border Height="1" Background="#ECF0E7" Margin="0,22,0,17"/>
      <TextBlock Text="只属于你的网络" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="手机和电脑登录同一 Tailscale 账号，电脑保持开机，即可继续记录。" TextWrapping="Wrap" Foreground="#7D897F" FontSize="12" LineHeight="20" Margin="0,7,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="17" Margin="0,14,0,0"><Expander x:Name="LogExpander" Header="运行日志" FontSize="12" Foreground="#73816F"><TextBox x:Name="LogText" Margin="0,12,0,0" Height="160" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander></Border>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <TextBlock Grid.Row="3" Text="关闭控制台，日记和手机访问仍会在后台运行。" Foreground="#929A90" FontSize="11" Margin="2,17,0,0"/>
 </Grid>
</Window>
